# Secrets and configuration files
.env
.env.*
*.local
backend/.env
frontend/.env

# Python specific ignores
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
*.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node dependencies and build output
node_modules/
dist/
dist-ssr/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# File formatting settings
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.html text eol=lf
